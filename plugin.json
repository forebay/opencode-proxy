{
  "api": 1,
  "importName": "opencode-proxy",
  "id": "opencode-proxy",
  "version": "3.0.0",
  "entry": "dist/plugin.js",
  "bundle": {
    "entry": "src/plugin.ts"
  },
  "displayName": "OpenCode proxy",
  "capabilities": {
    "provides": [],
    "consumes": [
      "forebay.provider"
    ]
  },
  "services": {
    "provides": [
      "opencode-proxy:opencode-plugin"
    ],
    "consumes": [
      "routing",
      "anthropic",
      "weivel.config",
      "weivel.log"
    ]
  },
  "config": {
    "defaults": {
      "upstream": "https://api.anthropic.com",
      "proxy": {
        "placeholderAuthorization": "Bearer sk-ant-loader-proxy"
      },
      "opencode": {
        "providerId": "forebay",
        "providerName": "forebay",
        "baseURL": "https://opencode-proxy.invalid/v1"
      },
      "routing": {
        "tierSourceProvider": "opencode",
        "tierOrder": [],
        "tierFallback": [],
        "defaultContext": 200000,
        "defaultOutput": 64000,
        "loginCommand": "spisor-host action opencode-loader"
      }
    }
  },
  "access": [
    {
      "kind": "network",
      "target": "setting:upstream",
      "mode": "connect",
      "why": "a request no provider serves passes through to the upstream"
    }
  ],
  "publish": {
    "scopedOnly": true
  },
  "repo": {
    "role": "OpenCode proxy layer",
    "category": "app-proxy",
    "domains": [
      "opencode"
    ],
    "tech": [
      "typescript"
    ]
  }
}
