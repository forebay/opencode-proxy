{
  "name": "opencode-proxy",
  "version": "3.0.0",
  "description": "The OpenCode proxy, a weivel plugin that runs inside OpenCode's process and asks forebay-library's C for every decision.",
  "main": "dist/plugin.js",
  "type": "module",
  "license": "MIT",
  "author": "intisy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/forebay/opencode-proxy.git"
  },
  "keywords": [
    "proxy",
    "anthropic",
    "opencode",
    "weivel",
    "intisy",
    "opencode-proxy"
  ],
  "files": [
    "dist/",
    "plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node scripts/native.ts && npm run build && tsc --noEmit && vitest run",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@weivel/typescript": "file:./siblings/typescript",
    "typescript": "5.7.2",
    "vitest": "3.2.7"
  }
}
